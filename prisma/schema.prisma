generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                   Int            @id @default(autoincrement())
  nombre               String
  apellido             String
  email                String         @unique
  passwordHash         String
  activo               Boolean        @default(true)
  rol                  RolUsuario     @default(ADMIN)
  createdAt            DateTime       @default(now())
  proveedorRestrictoId Int?
  comprasPagadas       Compra[]       @relation("CompraPagadaPor")
  compras              Compra[]
  gastosPagados        Gasto[]        @relation("GastoPagadoPor")
  gastos               Gasto[]
  logsActividad        LogActividad[]
  proveedorRestricto   Proveedor?     @relation("UsuarioProveedorRestricto", fields: [proveedorRestrictoId], references: [id])
  ventasCobradas       Venta[]        @relation("VentaCobradaPor")
  ventas               Venta[]
  ventasVendidas       Venta[]        @relation("VentaVendidaPor")
}

model TipoProducto {
  id     Int    @id @default(autoincrement())
  nombre String @unique
}

model Producto {
  id                   Int                         @id @default(autoincrement())
  skuInterno           String                      @unique
  nombre               String
  marca                String
  categoria            String
  presentacion         Presentacion
  unidadMedida         UnidadMedida                @default(UNIDAD)
  contenido            Decimal                     @default(1)
  stockActual          Int                         @default(0)
  precioCostoUnitario  Decimal                     @default(0)
  margenPorcentaje     Decimal                     @default(30)
  precioVenta          Decimal                     @default(0)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  stockEnConsignacion  Int                         @default(0)
  activo               Boolean                     @default(true)
  compras              Compra[]
  detallesConsignacion DetalleConsignacion[]
  detalleVentas        DetalleVenta[]
  historialStock       HistorialStockMayorista[]
  ordenesDropshipping  OrdenDropshipping[]
  clientesRecurrentes  ClienteProductoRecurrente[] @relation("ClienteProductoRecurrenteProducto")
  recordatorios        RecordatorioReposicion[]

  @@index([categoria])
}

model Proveedor {
  id                   Int                       @id @default(autoincrement())
  nombre               String
  direccion            String?
  contacto             String?
  compras              Compra[]
  historialMayorista   HistorialStockMayorista[]
  sociosConsignacion   SocioConsignacion[]
  usuariosRestringidos Usuario[]                 @relation("UsuarioProveedorRestricto")
}

model Compra {
  id                  Int       @id @default(autoincrement())
  proveedorId         Int
  productoId          Int
  cantidad            Int
  precioCostoUnitario Decimal
  descuentoPorcentaje Decimal   @default(0)
  costoEnvio          Decimal?  @default(0)
  numeroPedido        String?
  facturado           Boolean   @default(false)
  numeroFactura       String?
  fechaCompra         DateTime  @default(now())
  usuarioId           Int
  pagadoPorId         Int?
  pagadoPor           Usuario?  @relation("CompraPagadaPor", fields: [pagadoPorId], references: [id])
  producto            Producto  @relation(fields: [productoId], references: [id])
  proveedor           Proveedor @relation(fields: [proveedorId], references: [id])
  usuario             Usuario   @relation(fields: [usuarioId], references: [id])

  @@index([fechaCompra])
  @@index([productoId])
}

model Cliente {
  id                   Int                         @id @default(autoincrement())
  nombre               String
  apellido             String
  direccion            String
  telefono             String
  email                String?
  cuit                 String?
  dni                  String?
  mascotas             Mascota[]
  ordenesDropshipping  OrdenDropshipping[]
  productosRecurrentes ClienteProductoRecurrente[]
  recordatorios        RecordatorioReposicion[]
  ventas               Venta[]
}

model Mascota {
  id                    Int            @id @default(autoincrement())
  clienteId             Int
  tipo                  TipoMascota
  nombre                String
  edad                  String
  tamanio               TamanioMascota
  raza                  String?
  condicionesEspeciales String?
  creadoAt              DateTime       @default(now())
  cliente               Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
}

model ClienteProductoRecurrente {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  productoId  Int
  periodoDias Int
  notas       String?
  activo      Boolean  @default(true)
  creadoAt    DateTime @default(now())
  cliente     Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto    Producto @relation("ClienteProductoRecurrenteProducto", fields: [productoId], references: [id])

  @@unique([clienteId, productoId])
  @@index([clienteId])
}

model RecordatorioReposicion {
  id                      Int       @id @default(autoincrement())
  clienteId               Int
  productoId              Int
  fechaUltimaCompra       DateTime
  fechaEstimadaReposicion DateTime
  mensaje                 String
  enviado                 Boolean   @default(false)
  fechaEnvio              DateTime?
  creadoAt                DateTime  @default(now())
  cliente                 Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  producto                Producto  @relation(fields: [productoId], references: [id])

  @@index([clienteId])
  @@index([fechaEstimadaReposicion])
  @@index([enviado])
}

model Venta {
  id                Int            @id @default(autoincrement())
  clienteId         Int
  canalVenta        CanalVenta
  medioPago         String
  costoEnvio        Decimal        @default(0)
  facturado         Boolean        @default(false)
  numeroFactura     String?
  fechaAcreditacion DateTime?
  fechaVenta        DateTime       @default(now())
  esVentaInterna    Boolean        @default(false)
  usuarioId         Int
  vendidoPorId      Int?
  cobradoPorId      Int?
  costos            CostoVenta[]
  detalles          DetalleVenta[]
  cliente           Cliente        @relation(fields: [clienteId], references: [id])
  cobradoPor        Usuario?       @relation("VentaCobradaPor", fields: [cobradoPorId], references: [id])
  usuario           Usuario        @relation(fields: [usuarioId], references: [id])
  vendidoPor        Usuario?       @relation("VentaVendidaPor", fields: [vendidoPorId], references: [id])

  @@index([fechaVenta])
  @@index([clienteId])
}

model CostoVenta {
  id             Int     @id @default(autoincrement())
  ventaId        Int
  concepto       String
  esPorcentaje   Boolean @default(false)
  valor          Decimal
  incluyeEnvio   Boolean @default(false)
  montoCalculado Decimal
  venta          Venta   @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  @@index([ventaId])
}

model DetalleVenta {
  id                  Int                @id @default(autoincrement())
  ventaId             Int
  productoId          Int
  cantidad            Int
  precioVentaUnitario Decimal
  descuentoPorcentaje Decimal            @default(0)
  precioCostoUnitario Decimal?
  producto            Producto           @relation(fields: [productoId], references: [id])
  venta               Venta              @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  ventaConsignacion   VentaConsignacion?

  @@index([ventaId])
  @@index([productoId])
}

model MedioPago {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  activo Boolean @default(true)
}

model Gasto {
  id             Int       @id @default(autoincrement())
  monto          Decimal
  descripcion    String?
  fechaGasto     DateTime  @default(now())
  usuarioId      Int?
  pagadoPorId    Int?
  esFijo         Boolean   @default(false)
  tipoGasto      TipoGasto @default(VARIABLE)
  categoriaGasto String
  pagadoPor      Usuario?  @relation("GastoPagadoPor", fields: [pagadoPorId], references: [id])
  usuario        Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([fechaGasto])
}

model LogActividad {
  id        Int        @id @default(autoincrement())
  usuarioId Int
  accion    AccionLog
  entidad   EntidadLog
  entidadId Int?
  detalle   String?
  fecha     DateTime   @default(now())
  usuario   Usuario    @relation(fields: [usuarioId], references: [id])

  @@index([fecha])
  @@index([entidad, entidadId])
}

model HistorialStockMayorista {
  id                   Int        @id @default(autoincrement())
  productoId           Int?
  proveedorId          Int?
  sku                  String
  nombre               String?
  precioCostoScraped   Decimal
  precioConDescuento   Decimal?
  tamanios             String?
  estadoStockMayorista String?
  fechaImportacion     DateTime   @default(now())
  skuInterno           String?
  tipoProducto         String?
  activo               Boolean    @default(true)
  producto             Producto?  @relation(fields: [productoId], references: [id])
  proveedor            Proveedor? @relation(fields: [proveedorId], references: [id])

  @@unique([proveedorId, sku])
  @@index([fechaImportacion])
  @@index([sku])
  @@index([proveedorId])
}

model SocioConsignacion {
  id                  Int                       @id @default(autoincrement())
  nombre              String
  contacto            String?
  notas               String?
  proveedorId         Int?
  consignaciones      Consignacion[]
  liquidaciones       LiquidacionConsignacion[]
  ordenesDropshipping OrdenDropshipping[]
  proveedor           Proveedor?                @relation(fields: [proveedorId], references: [id])
}

model Consignacion {
  id            Int                      @id @default(autoincrement())
  socioId       Int
  direccion     DireccionConsignacion
  estado        EstadoConsignacion       @default(ABIERTA)
  fecha         DateTime                 @default(now())
  notas         String?
  liquidacionId Int?
  liquidacion   LiquidacionConsignacion? @relation(fields: [liquidacionId], references: [id])
  socio         SocioConsignacion        @relation(fields: [socioId], references: [id])
  items         DetalleConsignacion[]
  pagos         PagoConsignacion[]

  @@index([socioId])
  @@index([estado])
}

model DetalleConsignacion {
  id              Int                 @id @default(autoincrement())
  consignacionId  Int
  productoId      Int?
  descripcion     String?
  cantidad        Int
  precioCosto     Decimal
  precioPiso      Decimal
  cantidadVendida Int                 @default(0)
  consignacion    Consignacion        @relation(fields: [consignacionId], references: [id])
  producto        Producto?           @relation(fields: [productoId], references: [id])
  ventas          VentaConsignacion[]

  @@index([consignacionId])
}

model VentaConsignacion {
  id                    Int                      @id @default(autoincrement())
  detalleConsignacionId Int
  fecha                 DateTime                 @default(now())
  cantidad              Int
  precioVentaReal       Decimal
  liquidacionId         Int?
  facturado             Boolean                  @default(false)
  numeroFactura         String?
  detalleVentaId        Int?                     @unique
  detalle               DetalleConsignacion      @relation(fields: [detalleConsignacionId], references: [id])
  detalleVenta          DetalleVenta?            @relation(fields: [detalleVentaId], references: [id])
  liquidacion           LiquidacionConsignacion? @relation(fields: [liquidacionId], references: [id])

  @@index([detalleConsignacionId])
  @@index([liquidacionId])
}

model LiquidacionConsignacion {
  id              Int                 @id @default(autoincrement())
  socioId         Int
  fechaDesde      DateTime
  fechaHasta      DateTime
  fecha           DateTime            @default(now())
  totalACobrarnos Decimal
  totalACobrarles Decimal
  saldo           Decimal
  pagado          Boolean             @default(false)
  fechaPago       DateTime?
  notas           String?
  consignaciones  Consignacion[]
  socio           SocioConsignacion   @relation(fields: [socioId], references: [id])
  pagos           PagoConsignacion[]
  ventas          VentaConsignacion[]

  @@index([socioId])
}

model PagoConsignacion {
  id             Int                      @id @default(autoincrement())
  consignacionId Int
  fecha          DateTime                 @default(now())
  monto          Decimal
  notas          String?
  liquidacionId  Int?
  consignacion   Consignacion             @relation(fields: [consignacionId], references: [id])
  liquidacion    LiquidacionConsignacion? @relation(fields: [liquidacionId], references: [id])

  @@index([consignacionId])
  @@index([liquidacionId])
}

model OrdenDropshipping {
  id                     Int                @id @default(autoincrement())
  socioId                Int
  clienteId              Int?
  clienteNombre          String?
  fecha                  DateTime           @default(now())
  estado                 EstadoDropshipping @default(PENDIENTE)
  productoId             Int?
  descripcion            String?
  cantidad               Int
  precioCosto            Decimal
  precioVenta            Decimal
  facturadoAlCliente     Boolean            @default(false)
  facturadoPorProveedor  Boolean            @default(false)
  numeroFacturaCliente   String?
  numeroFacturaProveedor String?
  notas                  String?
  cliente                Cliente?           @relation(fields: [clienteId], references: [id])
  producto               Producto?          @relation(fields: [productoId], references: [id])
  socio                  SocioConsignacion  @relation(fields: [socioId], references: [id])

  @@index([socioId])
  @@index([estado])
}

model TiendanubeConfig {
  id          Int      @id @default(autoincrement())
  storeId     String   @unique
  accessToken String
  scope       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum RolUsuario {
  ADMIN
  LECTOR_RESTRINGIDO
}

enum Presentacion {
  BOLSA_CERRADA
  CAJA_CERRADA
  INDIVIDUAL
}

enum UnidadMedida {
  KILOGRAMOS
  GRAMOS
  LITROS
  MILILITROS
  UNIDAD
}

enum CanalVenta {
  TIENDANUBE
  WHATSAPP
  TELEFONO
}

enum AccionLog {
  CREAR
  ACTUALIZAR
  ELIMINAR
}

enum EntidadLog {
  COMPRA
  VENTA
  GASTO
  PRODUCTO
  USUARIO
  PROVEEDOR
}

enum DireccionConsignacion {
  ENTREGAMOS
  RECIBIMOS
}

enum EstadoConsignacion {
  ABIERTA
  CERRADA
}

enum EstadoDropshipping {
  PENDIENTE
  DESPACHADO
  ENTREGADO
  CANCELADO
}

enum TipoMascota {
  PERRO
  GATO
}

enum TamanioMascota {
  MINI
  PEQUENIO
  MEDIANO
  GRANDE
  GIGANTE
}

enum CategoriaGasto {
  MONOTRIBUTO
  TELEFONO
  COMMUNITY_MANAGER
  PUBLICIDAD
  SOPORTE_IT
  OTROS
}

enum TipoGasto {
  FIJO
  VARIABLE
  EXCEPCIONAL
  MARKETING
}

enum EstadoTablero {
  INGRESO_ORDEN_PENDIENTE
  CARGAR_ORDEN_VENTA_EM_1
  COMPRAR_MAYORISTA
  LISTA_PARA_DESPACHO
  DESPACHADA_EN_CAMINO
  PEDIDO_ENTREGADO
  CARGAR_ORDEN_VENTA_EM_2
  FACTURACION
  ORDEN_CERRADA_ARCHIVADA
}

model TarjetaTablero {
  id        Int           @id @default(autoincrement())
  titulo    String
  notas     String?
  estado    EstadoTablero @default(INGRESO_ORDEN_PENDIENTE)
  orden     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([estado])
}
