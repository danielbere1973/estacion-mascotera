# Connection string de CockroachDB Cloud (Serverless).
# Obtenerla desde: https://cockroachlabs.cloud -> tu cluster -> "Connect"
# Formato típico:
# postgresql://<usuario>:<password>@<host>:26257/<database>?sslmode=verify-full
DATABASE_URL="postgresql://usuario:password@host:26257/estacion_mascotera?sslmode=verify-full"

# NextAuth
AUTH_SECRET="generar-con: openssl rand -base64 32"

# Telegram (notificaciones salientes; TELEGRAM_WEBHOOK_SECRET reservado para fase 2, no usado todavía)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_WEBHOOK_SECRET=""

# URL pública de esta app (usada para armar la callbackUrl que se envía al servicio HYM)
NEXT_PUBLIC_APP_URL="https://sistema-em.vercel.app"

# Cron de Vercel (header Authorization: Bearer $CRON_SECRET en /api/cron/*)
CRON_SECRET=""

# Servicio Python de scraping HYM (corre en la PC de Daniel, fuera de este repo)
HYM_SCRAPER_URL=""
HYM_SCRAPER_SECRET=""

# Token compartido para validar el callback del servicio HYM (header X-Hym-Callback-Token)
HYM_CALLBACK_TOKEN=""
